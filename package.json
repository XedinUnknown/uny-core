{
  "name": "uny",
  "version": "0.0.0",
  "private": true,
  "description": "Exploration-first mobile app testing CLI.",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "lerna run build --stream",
    "build:changed": "lerna run build --since --stream",
    "test": "lerna run test --stream",
    "test:tooling": "node --test tests/*.test.*",
    "test:ui": "lerna run test -- --ui",
    "release": "lerna run build --since --stream && lerna publish from-package --yes",
    "version": "lerna version",
    "validate-specs": "make validate-specs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0",
    "@types/node": "^26.0.0",
    "@xedinunknown/agents-config": "github:XedinUnknown/agents-config#0.1.x",
    "lerna": "^9.0.7",
    "nx": "^23.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
