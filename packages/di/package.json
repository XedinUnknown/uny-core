{
  "name": "@uny/di",
  "version": "0.0.0",
  "description": "Config-based composition library: keyed definitions, extensions, deterministic order.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "import": "./dist/definitions.js"
    }
  },
  "main": "./dist/index.js",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts src/errors.ts src/definitions.ts --format esm --dts",
    "test": "node --import tsx --test tests/di.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0"
  }
}
