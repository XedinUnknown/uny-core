{
  "name": "@uny/core",
  "version": "0.0.0",
  "description": "Core app module: paths, config, basics.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "node --import tsx --test tests/core.test.ts",
    "spec:validate": "OPENSPEC_TELEMETRY=0 pnpm exec openspec validate --all --strict"
  },
  "dependencies": {
    "@uny/di": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.6.0"
  }
}
