{
  "$schema": "./mcp.servers.schema.json",
  "servers": {
    "serena": {
      "type": "stdio",
      "command": "${HOME}/.local/bin/uvx",
      "args": [
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context=ide",
        "--open-web-dashboard=false",
        "--project-from-cwd"
      ],
      "env": {
        "BROWSER": "/bin/true"
      }
    },
    "jetbrains": {
      "type": "sse",
      "url": "http://127.0.0.1:64342/sse"
    }
  }
}
