{
  "settings": {
    "claude": { "configPath": ".mcp.json" },
    "codex": { "configPath": ".codex/config.toml" }
  },
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "-p", "3.13",
        "--from", "git+https://github.com/oraios/serena@ede329aaf0c824bea75455a2926f01420d7aa620",
        "serena", "start-mcp-server",
        "--project", "${UNY_MCP_PROJECT_DIR}",
        "--context", "ide",
        "--agent-interface", "tools",
        "--open-web-dashboard", "false"
      ]
    },
    "jetbrains": {
      "type": "sse",
      "url": "http://127.0.0.1:64342/sse",
      "proxy": true
    }
  }
}
