{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "uny": {
      "type": "remote",
      "url": "http://127.0.0.1:19100/mcp"
    }
  },
  "permission": {
    "edit": "allow",
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "task": "allow",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "node*": "allow",
      "npm*": "allow",
      "npx*": "allow",
      "pnpm*": "allow",
      "yarn*": "allow",
      "docker ps*": "allow",
      "docker compose ps*": "allow",
      "docker compose config*": "allow",
      "docker compose build*": "allow",
      "docker compose up*": "allow",
      "docker compose logs*": "allow",
      "docker compose down*": "allow",
      "vitest*": "allow",
      "tsc*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "rm -rf*": "ask",
      "docker system prune*": "ask"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
